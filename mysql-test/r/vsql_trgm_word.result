# vsql_trgm: trgm_word_similarity and trgm_word_distance
INSTALL EXTENSION vsql_trgm;
#
# trgm_word_similarity — exact word match in longer string
#
SELECT vsql_trgm.trgm_word_similarity('cat', 'a cat sat on a mat');
vsql_trgm.trgm_word_similarity('cat', 'a cat sat on a mat')
1
SELECT vsql_trgm.trgm_word_similarity('hello', 'hello world');
vsql_trgm.trgm_word_similarity('hello', 'hello world')
1
SELECT vsql_trgm.trgm_word_similarity('abc', 'xyz abc def');
vsql_trgm.trgm_word_similarity('abc', 'xyz abc def')
1
#
# trgm_word_similarity — no match
#
SELECT vsql_trgm.trgm_word_similarity('zzz', 'abc def ghi');
vsql_trgm.trgm_word_similarity('zzz', 'abc def ghi')
0
#
# trgm_word_similarity — identical single word
#
SELECT vsql_trgm.trgm_word_similarity('cat', 'cat');
vsql_trgm.trgm_word_similarity('cat', 'cat')
1
#
# trgm_word_similarity — NULL handling
#
SELECT vsql_trgm.trgm_word_similarity(NULL, 'hello world');
vsql_trgm.trgm_word_similarity(NULL, 'hello world')
NULL
SELECT vsql_trgm.trgm_word_similarity('hello', NULL);
vsql_trgm.trgm_word_similarity('hello', NULL)
NULL
#
# trgm_word_distance — complement of word_similarity
#
SELECT vsql_trgm.trgm_word_distance('cat', 'a cat sat on a mat');
vsql_trgm.trgm_word_distance('cat', 'a cat sat on a mat')
0
SELECT vsql_trgm.trgm_word_distance('hello', 'hello world');
vsql_trgm.trgm_word_distance('hello', 'hello world')
0
SELECT vsql_trgm.trgm_word_distance(NULL, 'abc');
vsql_trgm.trgm_word_distance(NULL, 'abc')
NULL
#
# trgm_word_similar (default threshold 0.6)
#
SELECT vsql_trgm.trgm_word_similar('cat', 'a cat sat on a mat');
vsql_trgm.trgm_word_similar('cat', 'a cat sat on a mat')
1
SELECT vsql_trgm.trgm_word_similar('hello', 'hello world');
vsql_trgm.trgm_word_similar('hello', 'hello world')
1
SELECT vsql_trgm.trgm_word_similar('zzz', 'abc def ghi');
vsql_trgm.trgm_word_similar('zzz', 'abc def ghi')
0
SELECT vsql_trgm.trgm_word_similar(NULL, 'hello world');
vsql_trgm.trgm_word_similar(NULL, 'hello world')
NULL
UNINSTALL EXTENSION vsql_trgm;
